# ==========================================
# NatureQuest AI Environment Variables
# ==========================================

# Backend Configuration
PROJECT_NAME="NatureQuest AI"
VERSION="1.0.0"

# Local SQLite (default) or PostgreSQL
DATABASE_URL="sqlite:///./naturequest.db"
# For PostgreSQL: DATABASE_URL="postgresql://naturequest:naturequest123@localhost:5432/naturequest_db"

# JWT Secret (Generate a strong random string in production)
SECRET_KEY="replace-with-a-secure-random-jwt-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API (Get key from https://aistudio.google.com/)
# If empty, NatureQuest AI automatically uses its safe fallback quest & vision engine.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Plant Identification Provider ('gemini' or 'mock')
VISION_PROVIDER="gemini"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
